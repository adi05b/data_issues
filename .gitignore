# ---- Allowlist: ignore everything, then re-include only these types ----
*
!*/
!.gitignore
!*.md
!*.txt
!*.py
!*.sql
!*.rq
!*.sh
!*.yml
!*.csv
!*.json

# ---- Client files (Adriana) ----
commodity_bad_normalizations.csv
defect-evidence-rows.pdf
*.pdf
*.xlsx
*.xls

# ---- Downloaded third-party datasets ----
geoboundaries*/
**/naturalearth/src/
**/gb_editions/*.geojson
*.geojson
*.shp
*.gpkg
*.tif
apache-jena*
*.tar.gz
*.zip

# ---- Run outputs and big data ----
rerun/
run-*/
databases/
*.sqlite
*.sqlite.inited
*.dump
*.sql.gz

# ---- Clones of other repos ----
ta2-minmod-data/
ta2-minmod-kg/
minmod_data_issues/

# ---- Environment and tooling ----
.venv*/
__pycache__/
*.pyc
.env*
.[c]laude/
[cC][lL][aA][uU][dD][eE].md
.DS_Store

