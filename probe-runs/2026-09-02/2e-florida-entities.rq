PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?ent ?label ?country_raw ?country_label WHERE {
  ?ent a :StateOrProvince ; rdfs:label ?label .
  FILTER(LCASE(STR(?label)) = "florida")
  OPTIONAL { ?ent :country ?country_raw }
  OPTIONAL { ?ent :country ?cr .
             BIND(IRI(CONCAT("https://minmod.isi.edu/resource/", STR(?cr))) AS ?ce)
             ?ce rdfs:label ?country_label }
}
