PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?source ?matcher (COUNT(DISTINCT ?site) AS ?candidates)
WHERE {
  ?site a :MineralSite ; :source_id ?source ; :location_info ?li .
  ?li :state_or_province ?sc .
  ?sc :normalized_uri ?state_ent ; :source ?matcher .
}
GROUP BY ?source ?matcher ORDER BY DESC(?candidates)
