PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?obs ?src ?label ?conf ?matcher (COUNT(DISTINCT ?site) AS ?records)
WHERE {
  ?site a :MineralSite ; :mineral_inventory ?mi .
  OPTIONAL { ?site :source_id ?src }
  ?mi :commodity ?cm .
  ?cm :observed_name ?obs .
  FILTER(STRLEN(STR(?obs)) = 1)
  OPTIONAL { ?cm :confidence ?conf }
  OPTIONAL { ?cm :source ?matcher }
  OPTIONAL { ?cm :normalized_uri ?ent . OPTIONAL { ?ent rdfs:label ?label } }
}
GROUP BY ?obs ?src ?label ?conf ?matcher
ORDER BY DESC(?records)
