PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?source ?lon_dp (COUNT(DISTINCT ?site) AS ?sites)
WHERE {
  ?site a :MineralSite ; :source_id ?source ; :location_info ?li .
  ?li :location ?wkt ; :crs ?crsc .
  ?crsc :normalized_uri ?ce . ?ce rdfs:label ?crs .
  FILTER(STR(?crs) = "EPSG:4326")
  BIND(REPLACE(STR(?wkt), "^\\s*POINT\\s*\\(\\s*([-+0-9.eE]+)\\s+[-+0-9.eE]+\\s*\\).*$", "$1") AS ?s)
  BIND(IF(CONTAINS(?s,"."), STRLEN(STRAFTER(?s,".")), 0) AS ?lon_dp)
  FILTER(?lon_dp <= 1)
}
GROUP BY ?source ?lon_dp ORDER BY DESC(?sites)
