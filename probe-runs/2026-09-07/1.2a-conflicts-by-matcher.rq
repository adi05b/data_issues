PREFIX : <https://minmod.isi.edu/ontology/>
SELECT ?state_src (COUNT(DISTINCT ?site) AS ?sites)
WHERE {
  ?site a :MineralSite ; :location_info ?li .
  ?li :state_or_province ?sc ; :country ?cc .
  ?sc :normalized_uri ?state_ent ; :source ?state_src .
  ?cc :normalized_uri ?country_ent .
  ?state_ent :country ?scr .
  BIND(REPLACE(STR(?scr), "^.*/", "") AS ?a)
  BIND(REPLACE(STR(?country_ent), "^.*/", "") AS ?b)
  FILTER(?a != ?b)
}
GROUP BY ?state_src ORDER BY DESC(?sites)
