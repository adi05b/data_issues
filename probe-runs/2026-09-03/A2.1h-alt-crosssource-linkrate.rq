PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?source (COUNT(DISTINCT ?site) AS ?sites_with_loc) (COUNT(DISTINCT ?linked) AS ?cross_source_linked)
WHERE {
  ?site a :MineralSite ; :source_id ?source ; :location_info ?li .
  ?li :location ?wkt .
  OPTIONAL {
    { SELECT DISTINCT ?linked WHERE {
        { ?linked owl:sameAs ?o . ?linked :source_id ?a . ?o :source_id ?b . FILTER(STR(?a) != STR(?b)) }
        UNION
        { ?x owl:sameAs ?linked . ?x :source_id ?a . ?linked :source_id ?b . FILTER(STR(?a) != STR(?b)) }
    } }
    FILTER(?linked = ?site)
  }
}
GROUP BY ?source
ORDER BY DESC(?sites_with_loc)
