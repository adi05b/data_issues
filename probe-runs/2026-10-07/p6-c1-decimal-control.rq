# Control: same filter shape, decimal instead of double -- must return rows
PREFIX mo: <https://minmod.isi.edu/ontology/>
PREFIX gco: <https://geochemistry.isi.edu/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?s ?p ?o (DATATYPE(?o) AS ?dt) WHERE {
  VALUES ?p { mo:confidence mo:value gco:grade }
  ?s ?p ?o FILTER(DATATYPE(?o) = xsd:decimal)
} LIMIT 5
