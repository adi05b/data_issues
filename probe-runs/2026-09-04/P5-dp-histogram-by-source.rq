PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?source ?latd (COUNT(DISTINCT ?site) AS ?sites)
WHERE {
  ?site a :MineralSite ; :source_id ?source ; :location_info ?li .
  FILTER(STR(?source) = "https://mrdata.usgs.gov/mrds" || STR(?source) = "https://doi.org/10.5066/P9HTERGK" || STR(?source) = "https://mrdata.usgs.gov/nicrpge")
  ?li :location ?wkt ; :crs ?crsc .
  ?crsc :normalized_uri ?ce . ?ce rdfs:label ?crs .
  FILTER(STR(?crs) = "EPSG:4326")
  BIND(REPLACE(STR(?wkt), "^\\s*POINT\\s*\\(\\s*[-+0-9.eE]+\\s+([-+0-9.eE]+)\\s*\\).*$", "$1") AS ?las)
  BIND(IF(CONTAINS(?las,"."), STRLEN(STRAFTER(?las,".")), 0) AS ?latd)
}
GROUP BY ?source ?latd ORDER BY ?source ?latd
