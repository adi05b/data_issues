PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?crs_label (COUNT(DISTINCT ?site) AS ?records)
WHERE {
  ?site a :MineralSite ; :source_id "https://doi.org/10.5066/P96MMRFD" ; :location_info ?li .
  OPTIONAL { ?li :crs ?c . ?c :normalized_uri ?ce . ?ce rdfs:label ?crs_label }
}
GROUP BY ?crs_label ORDER BY DESC(?records)
