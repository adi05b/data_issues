PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?source (COUNT(DISTINCT ?site) AS ?affected) WHERE {
  ?site a :MineralSite ; :source_id ?source ; :location_info ?li .
  ?li :location ?wkt ; :crs ?c .
  ?c :normalized_uri ?ce . ?ce rdfs:label ?crs . FILTER(STR(?crs) = "EPSG:4326")
  BIND(REPLACE(STR(?wkt), "^[A-Z]*POINT\\s*\\(\\s*([-+0-9.eE]+)\\s+([-+0-9.eE]+)\\s*\\).*$", "$1") AS ?lons)
  BIND(REPLACE(STR(?wkt), "^[A-Z]*POINT\\s*\\(\\s*([-+0-9.eE]+)\\s+([-+0-9.eE]+)\\s*\\).*$", "$2") AS ?lats)
  BIND(IF(CONTAINS(?lons,"."), STRLEN(STRAFTER(?lons,".")), 0) AS ?dlon)
  BIND(IF(CONTAINS(?lats,"."), STRLEN(STRAFTER(?lats,".")), 0) AS ?dlat)
  FILTER(xsd:double(?lons) = 0.0 && xsd:double(?lats) = 0.0)
} GROUP BY ?source ORDER BY DESC(?affected)
