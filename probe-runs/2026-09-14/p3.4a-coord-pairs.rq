PREFIX : <https://minmod.isi.edu/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?s ?s_src ?s_wkt ?s_label ?o ?o_src ?o_wkt ?o_label
WHERE {
  ?s a :MineralSite ; owl:sameAs ?o ; :source_id ?s_src .
  ?s :location_info ?li1 . ?li1 :location ?s_wkt ; :crs ?c1 .
  ?c1 :normalized_uri ?e1 . ?e1 rdfs:label ?k1 . FILTER(STR(?k1)="EPSG:4326")
  ?o :source_id ?o_src .
  ?o :location_info ?li2 . ?li2 :location ?o_wkt ; :crs ?c2 .
  ?c2 :normalized_uri ?e2 . ?e2 rdfs:label ?k2 . FILTER(STR(?k2)="EPSG:4326")
  OPTIONAL { ?s rdfs:label ?s_label }
  OPTIONAL { ?o rdfs:label ?o_label }
}
ORDER BY ?s ?o
